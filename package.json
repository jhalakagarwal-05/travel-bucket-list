{
  "name": "wanderlist-auth",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/index.js",
    "start": "NODE_ENV=production node dist/index.js",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx server/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "bcryptjs": "^3.0.2",
    "chart.js": "^4.6.1",
    "connect-pg-simple": "^10.0.0",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "express-session": "^1.18.2",
    "leaflet": "^1.9.4",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.5"
  },
  "overrides": {
    "drizzle-kit": {
      "@esbuild-kit/esm-loader": "npm:tsx@^4.23.15"
    }
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.23",
    "@types/express-session": "^1.18.2",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.12",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^5.1.0"
  }
}
